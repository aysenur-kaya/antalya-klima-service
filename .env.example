# PostgreSQL bağlantı dizesi (Prisma)
# Örnek yerel: postgresql://postgres:postgres@localhost:5432/izmir_klima_admin?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/izmir_klima_admin?schema=public"

# Admin oturum JWT imzası (en az 32 karakter, rastgele üretin)
SESSION_SECRET="your-long-random-secret-at-least-32-characters-long"

